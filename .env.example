# ---------- n8n ----------
N8N_HOST=your-domain.ngrok-free.app
WEBHOOK_URL=https://your-domain.ngrok-free.app/
N8N_ENCRYPTION_KEY=generate-a-long-random-string
GENERIC_TIMEZONE=Europe/Kyiv
TZ=Europe/Kyiv

# ---------- ngrok ----------
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-domain.ngrok-free.app

# ---------- Qdrant ----------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ---------- WooCommerce ----------
WOO_STORE_URL=https://woo-copilot.local
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# ---------- LLM providers ----------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Telegram ----------
# Bot token from @BotFather (format: <bot_id>:<secret>)
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs allowed to use the bot (no spaces)
TELEGRAM_OWNER_CHAT_ID=

# ---------- Slack ----------
SLACK_WEBHOOK_URL=
BUSINESS_TIMEZONE=Europe/Kyiv

# ---------- Wordpress ----------
WP_APP_USER=
WP_APP_PASSWORD=
COPILOT_API_BASE=https://woocommerceautomationtraining.local/wp-json/copilot/v1

Select-String -Path ".env.example" -Pattern "^(WP_APP_USER|WP_APP_PASSWORD|COPILOT_API_BASE)=" | Select-Object Line