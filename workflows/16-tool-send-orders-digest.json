      "parameters": {
        "jsCode": "const DateTime = $now.constructor;\n\nconst input = $input.first().json;\nconst businessTz = $env.BUSINESS_TIMEZONE || 'Europe/Kyiv';\nconst DEFAULT_WINDOW_DAYS = 7;\n\nfunction parseDateOnly(value) {\n  if (typeof value !== 'string' || value.trim() === '') return null;\n  const dt = DateTime.fromISO(value.trim(), { zone: businessTz });\n  return dt.isValid ? dt.startOf('day') : null;\n}\n\nconst nowBiz = $now.setZone(businessTz);\nconst todayStart = nowBiz.startOf('day');\n\nlet dateFrom = parseDateOnly(input.date_from);\nlet dateTo = parseDateOnly(input.date_to);\nconst errors = [];\n\nif (input.date_from && !dateFrom) errors.push(`date_from is not a valid date: ${input.date_from}`);\nif (input.date_to && !dateTo) errors.push(`date_to is not a valid date: ${input.date_to}`);\n\nif (!dateFrom && !dateTo) {\n  dateTo = todayStart;\n  dateFrom = todayStart.minus({ days: DEFAULT_WINDOW_DAYS - 1 });\n} else if (dateFrom && !dateTo) {\n  dateTo = todayStart;\n} else if (!dateFrom && dateTo) {\n  dateFrom = dateTo.minus({ days: DEFAULT_WINDOW_DAYS - 1 });\n}\n\nif (dateFrom && dateTo && dateFrom > dateTo) {\n  errors.push(`date_from (${dateFrom.toISODate()}) is after date_to (${dateTo.toISODate()})`);\n}\n\nconst days = dateFrom && dateTo ? Math.round(dateTo.diff(dateFrom, 'days').days) + 1 : null;\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    date_from: dateFrom ? dateFrom.toISODate() : null,\n    date_to: dateTo ? dateTo.toISODate() : null,\n    days,\n    coupons_after_utc: todayStart.toUTC().toISO(),\n    coupons_before_utc: nowBiz.toUTC().toISO(),\n  }\n}];"
      },
