    {
      "parameters": {
        "jsCode": "const ordersSummary = $('call-orders-summary').first().json;\nconst topReturned = $('call-top-returned').first().json;\nconst couponItems = $('fetch-coupons-today').all().map(item => item.json);\nconst prep = $('prepare-request').first().json;\n\nconst dateFrom = prep.date_from;\nconst dateTo = prep.date_to;\n\nfunction fmtMoney(value, currency) {\n  if (value === null || value === undefined || value === '') return 'н/д';\n  const num = Number(value);\n  if (Number.isNaN(num)) return String(value);\n  return currency ? `${num.toFixed(2)} ${currency}` : num.toFixed(2);\n}\n\nconst blocks = [];\n\nblocks.push({\n  type: 'header',\n  text: { type: 'plain_text', text: `📊 Дайджест заказов: ${dateFrom} – ${dateTo}`, emoji: true },\n});\n\n// Orders summary\nconst m = ordersSummary.metrics || {};\nconst currency = m.currency || '';\nlet ordersText;\nif (ordersSummary.status === 'no_data') {\n  ordersText = '_Заказов за период не найдено._';\n} else {\n  ordersText =\n    `*Заказы:* ${m.orders_count ?? 0}\\n` +\n    `*Выручка (gross):* ${fmtMoney(m.revenue_gross, currency)}\\n` +\n    `*Выручка (net):* ${fmtMoney(m.revenue_net, currency)}\\n` +\n    `*Возвраты:* ${fmtMoney(m.refunds_total, currency)}\\n` +\n    `*Средний чек:* ${fmtMoney(m.aov, currency)}`;\n}\nblocks.push({\n  type: 'section',\n  text: { type: 'mrkdwn', text: `*Сводка заказов*\\n${ordersText}` },\n});\n\nblocks.push({ type: 'divider' });\n\n// Top returned products\nconst totals = topReturned.totals || {};\nconst top = topReturned.top || [];\nlet returnedText;\nif (!top.length) {\n  returnedText = '_Возвратов за период не найдено._';\n} else {\n  const lines = top.map(\n    (p) => `${p.rank}. *${p.name}* — возвращено ${p.units_returned} шт. на ${fmtMoney(p.refund_amount, currency)}`\n  );\n  returnedText =\n    `*Всего возвратов:* ${totals.refunds_count ?? 0}, на сумму ${fmtMoney(totals.refund_amount, currency)}\\n\\n` +\n    lines.join('\\n');\n}\nblocks.push({\n  type: 'section',\n  text: { type: 'mrkdwn', text: `*Топ возвращаемых товаров*\\n${returnedText}` },\n});\n\nblocks.push({ type: 'divider' });\n\n// Coupons created today\nlet couponsText;\nif (!couponItems.length) {\n  couponsText = '_Сегодня купоны не создавались._';\n} else {\n  const lines = couponItems.map((c) => {\n    const suffix = c.discount_type === 'percent' ? '%' : currency;\n    return `• \\`${c.code}\\` — ${c.amount}${suffix} (${c.discount_type})`;\n  });\n  couponsText = lines.join('\\n');\n}\nblocks.push({\n  type: 'section',\n  text: { type: 'mrkdwn', text: `*Купоны, созданные сегодня*\\n${couponsText}` },\n});\n\nconst fallbackText = `Дайджест заказов ${dateFrom} – ${dateTo}`;\n\nreturn [{\n  json: {\n    blocks,\n    text: fallbackText,\n  },\n}];"
      },
