    {
      "parameters": {
        "jsCode": "const categoryId = $('prepare-request').first().json.category_id;\nconst categories = $input.all().map(item => item.json).filter(c => c && c.id !== undefined);\n\nconst byId = {};\nconst childrenOf = {};\nfor (const cat of categories) {\n  byId[cat.id] = cat;\n  const parent = cat.parent ?? 0;\n  if (!childrenOf[parent]) childrenOf[parent] = [];\n  childrenOf[parent].push(cat);\n}\n\nif (!byId[categoryId]) {\n  return [{ json: { found: false } }];\n}\n\nfunction collectDescendants(id) {\n  let ids = [id];\n  for (const child of (childrenOf[id] || [])) {\n    ids = ids.concat(collectDescendants(child.id));\n  }\n  return ids;\n}\n\nreturn [{\n  json: {\n    found: true,\n    category: { id: byId[categoryId].id, slug: byId[categoryId].slug, name: byId[categoryId].name },\n    descendant_category_ids: collectDescendants(categoryId),\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -80
      ],
