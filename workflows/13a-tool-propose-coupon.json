    },
    {
      "parameters": {
        "jsCode": "const prep = $('prepare-request').first().json;\nconst resolved = $input.first().json;\n\nconst businessTz = $env.BUSINESS_TIMEZONE || 'Europe/Kyiv';\nconst today = DateTime.now().setZone(businessTz).toISODate();\nconst todayCompact = today.replace(/-/g, '');\nconst expiresOn = DateTime.now().setZone(businessTz).plus({ days: prep.expires_days }).toISODate();\n\nconst discountToken = String(prep.discount_percent).replace('.', '_');\nconst code = `${resolved.category.slug.toUpperCase()}-${discountToken}-${todayCompact}`;\n\nconst payload = {\n  code,\n  discount_type: 'percent',\n  amount: prep.discount_percent.toFixed(2),\n  date_expires: expiresOn,\n  individual_use: true,\n  exclude_sale_items: true,\n  usage_limit_per_user: 1,\n  product_categories: resolved.descendant_category_ids,\n};\n\nreturn [{\n  json: {\n    category: resolved.category,\n    descendant_category_ids: resolved.descendant_category_ids,\n    payload,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
