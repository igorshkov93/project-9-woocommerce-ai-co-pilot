    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    status: 'no_data',\n    message: `category id ${$('prepare-request').first().json.category_id} not found`,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
