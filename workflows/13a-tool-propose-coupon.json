    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst categoryId = input.category_id;\nconst discountPercent = input.discount_percent;\nconst expiresDays = input.expires_days ?? 14;\n\nlet error = null;\nif (typeof categoryId !== 'number' || !Number.isInteger(categoryId)) {\n  error = 'category_id must be an integer';\n} else if (typeof discountPercent !== 'number' || discountPercent <= 0 || discountPercent > 100) {\n  error = 'discount_percent must be a number in (0, 100]';\n} else if (typeof expiresDays !== 'number' || expiresDays < 1) {\n  error = 'expires_days must be >= 1';\n}\n\nconst wooBaseUrl = ($env.WOO_STORE_URL || '').replace(/\\/+$/, '');\nconst key = $env.WOO_CONSUMER_KEY || '';\nconst secret = $env.WOO_CONSUMER_SECRET || '';\nconst authHeader = 'Basic ' + Buffer.from(`${key}:${secret}`).toString('base64');\n\nreturn [{\n  json: {\n    valid: error === null,\n    error,\n    category_id: categoryId,\n    discount_percent: discountPercent,\n    expires_days: expiresDays,\n    wooBaseUrl,\n    authHeader,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
