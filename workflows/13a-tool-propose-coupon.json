    {
      "parameters": {
        "jsCode": "const buildResult = $('build-payload').first().json;\nconst dupItems = $input.all().map(i => i.json).filter(c => c && c.id !== undefined);\nconst existing = dupItems.length > 0 ? dupItems[0] : null;\n\nreturn [{\n  json: {\n    status: 'proposed',\n    category: buildResult.category,\n    descendant_category_ids: buildResult.descendant_category_ids,\n    would_be_duplicate: existing !== null,\n    existing_coupon: existing ? { id: existing.id, code: existing.code } : null,\n    payload: buildResult.payload,\n  }\n}];"
      },
