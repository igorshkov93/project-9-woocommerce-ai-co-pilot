    {
      "parameters": {
        "jsCode": "// Fail-closed access control. Only chat IDs listed in the\n// TELEGRAM_OWNER_CHAT_ID env var may use this bot.\n// This node only classifies; routing happens in the IF node downstream.\nconst raw = $env.TELEGRAM_OWNER_CHAT_ID || '';\nconst allowed = raw.split(',').map((s) => s.trim()).filter(Boolean);\n\nconst update = $input.first().json;\nconst source = update.message ?? update.callback_query?.message ?? {};\nconst from = update.message?.from ?? update.callback_query?.from ?? {};\n\nconst chatId = source.chat?.id;\nconst userId = from.id;\nconst text = update.message?.text ?? update.callback_query?.data ?? '';\n\nconst isAllowed = chatId !== undefined && allowed.includes(String(chatId));\n\nreturn [\n  {\n    json: {\n      allowed: isAllowed,\n      reason: isAllowed ? 'ok' : 'chat_id_not_in_whitelist',\n      chatId,\n      userId,\n      text,\n      updateId: update.update_id,\n      receivedAt: new Date().toISOString(),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
