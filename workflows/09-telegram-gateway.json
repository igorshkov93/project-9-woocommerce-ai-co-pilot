    {
      "parameters": {
        "jsCode": "// Fail-closed access control. Only chat IDs listed in the\n// TELEGRAM_OWNER_CHAT_ID env var may use this bot.\n// This node only classifies; routing happens in the IF node downstream.\nconst raw = $env.TELEGRAM_OWNER_CHAT_ID || '';\nconst allowed = raw.split(',').map((s) => s.trim()).filter(Boolean);\nconst update = $input.first().json;\nconst updateType = update.callback_query ? 'callback_query' : update.message ? 'message' : 'unknown';\nconst source = update.message ?? update.callback_query?.message ?? {};\nconst from = update.message?.from ?? update.callback_query?.from ?? {};\nconst chatId = source.chat?.id;\nconst userId = from.id;\nconst text = update.message?.text ?? update.callback_query?.data ?? '';\nconst callbackQueryId = update.callback_query?.id;\nconst isAllowed = chatId !== undefined && allowed.includes(String(chatId));\nreturn [\n  {\n    json: {\n      allowed: isAllowed,\n      reason: isAllowed ? 'ok' : 'chat_id_not_in_whitelist',\n      updateType,\n      chatId,\n      userId,\n      text,\n      callbackQueryId,\n      updateId: update.update_id,\n      receivedAt: new Date().toISOString(),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
