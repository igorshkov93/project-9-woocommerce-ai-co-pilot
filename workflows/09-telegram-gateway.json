    {
      "parameters": {
        "jsCode": "// Parse callback_data from a coupon-confirmation button tap.\n// Expected format: cc:{category_id}:{discount_percent}:{expires_days}\n// e.g. \"cc:67:15:14\"\nconst item = $input.first().json;\nconst raw = item.text || '';\nconst parts = raw.split(':');\n\nif (parts.length !== 4 || parts[0] !== 'cc') {\n  return [\n    {\n      json: {\n        ...item,\n        parseOk: false,\n        parseError: `Unrecognized callback_data format: \"${raw}\"`,\n      },\n    },\n  ];\n}\n\nconst categoryId = Number(parts[1]);\nconst discountPercent = Number(parts[2]);\nconst expiresDays = Number(parts[3]);\n\nconst isValid =\n  Number.isFinite(categoryId) &&\n  Number.isFinite(discountPercent) &&\n  Number.isFinite(expiresDays);\n\nif (!isValid) {\n  return [\n    {\n      json: {\n        ...item,\n        parseOk: false,\n        parseError: `Non-numeric fields in callback_data: \"${raw}\"`,\n      },\n    },\n  ];\n}\n\nreturn [\n  {\n    json: {\n      ...item,\n      parseOk: true,\n      category_id: categoryId,\n      discount_percent: discountPercent,\n      expires_days: expiresDays,\n    },\n  },\n];"
      },
